	<div class="promotion">
		<ul class="p_list">
			<li class="p_item _LAZY_LOADING_WRAP as_type_qr">
				<button type="button" class="p_image _LAZY_LOADING_ERROR_HIDE _TOGGLE" data-target="_PROMOTION_QRCODE_LAYER_0" data-classValue="is_hidden" data-dimmed="true" data-clk="promoqrl">
					<img data-src="https://imgnews.pstatic.net/image/661/2026/07/14/QRCODE_0000079829_001_20260714142620799.jpg" alt="" width="36" height="36" class="_LAZY_LOADING">
				</button>
