			window.gladsdk = window.gladsdk || { cmd: [] };
			gladsdk.cmd.push(function() {
				gladsdk.setAdDeduplication("news_dedup");
				gladsdk.setGlobalConfig({ enablePersistAd: true });

				var adInfoList = [];

				adInfoList.push({
					seq: 1,
					unitId: "p_news_newsend",
